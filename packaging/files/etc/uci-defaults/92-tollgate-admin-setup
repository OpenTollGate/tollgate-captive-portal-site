#!/bin/sh
# TollGate admin board setup: create the dedicated uhttpd instance on :8090 and
# make sure rpcd (which serves the `tollgate` ubus object) is running.
#
# The admin SPA is served at the ROOT of :8090 from its brand webroot
# (/www/tollgate, or /www/net4sats for net4sats builds). LuCI stays on
# uhttpd.main (:8080; webroot /www) and the captive portal on uhttpd.portal
# (:2051); neither is touched here, and the admin instance never exposes LuCI's
# /www.
#
# Idempotent: creates the section if missing, and migrates the older
# home=/www + /tollgate/ scheme.

ADMIN_HOME=
for candidate in /www/tollgate /www/net4sats; do
    if [ -d "$candidate" ]; then
        ADMIN_HOME="$candidate"
        break
    fi
done
[ -n "$ADMIN_HOME" ] || ADMIN_HOME=/www/tollgate

if ! uci -q get uhttpd.admin >/dev/null 2>&1; then
    echo "Creating uhttpd admin instance on :8090 (home ${ADMIN_HOME})"
    uci set uhttpd.admin=uhttpd
    uci -q delete uhttpd.admin.listen_http
    uci add_list uhttpd.admin.listen_http='0.0.0.0:8090'
    uci add_list uhttpd.admin.listen_http='[::]:8090'
    uci set uhttpd.admin.ubus_prefix='/ubus'
    uci set uhttpd.admin.script_timeout='60'
    uci set uhttpd.admin.network_timeout='30'
    uci set uhttpd.admin.max_requests='3'
    uci set uhttpd.admin.tcp_keepalive='1'
    uci set uhttpd.admin.no_dirlists='1'
    uci set uhttpd.admin.home="$ADMIN_HOME"
    uci set uhttpd.admin.error_page='/index.html'
    uci commit uhttpd
else
    # Migrate the older scheme (home=/www, SPA at /tollgate/) and keep the error
    # page pointing at the SPA root.
    changed=0
    [ "$(uci -q get uhttpd.admin.home)" = "$ADMIN_HOME" ] || { uci set uhttpd.admin.home="$ADMIN_HOME"; changed=1; }
    [ "$(uci -q get uhttpd.admin.error_page)" = "/index.html" ] || { uci set uhttpd.admin.error_page='/index.html'; changed=1; }
    [ "$changed" = 1 ] && uci commit uhttpd
fi

# Resolve .apk-new files left by apk when existing files were modified.
find "$ADMIN_HOME" -name '*.apk-new' \
    -exec sh -c 'mv "$1" "${1%.apk-new}"' _ {} \; 2>/dev/null

/etc/init.d/rpcd restart
/etc/init.d/uhttpd restart

exit 0
