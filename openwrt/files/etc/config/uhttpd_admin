# Reference snapshot of the uhttpd "admin" instance created by
# packaging/files/etc/uci-defaults/92-tollgate-admin-setup.
#
# MODE-AWARE (D2): the instance owns ONE of the two admin pairs, decided by the
# `entry_ui` switch — the flat field of /etc/tollgate/config.json (default
# `board`; a missing file, a missing key, an empty or unparseable value, and an
# absent `jq` all resolve to `board`). The snapshot below is the DEFAULT,
# `entry_ui=board`: the board owns the ENTRY pair (:8080 HTTP + :443 TLS) and
# LuCI keeps the secondary pair (:8090 + :8443) on uhttpd.main. With
# `entry_ui=luci` the reverse holds and this instance binds :8090 + :8443 exactly
# as it did before the switch existed. The port SETS never change, only which UI
# answers on each.
#
# The admin board is a second (Preact) SPA served at the ROOT of the pair this
# instance owns, from its BRAND webroot. It binds the same ubus socket as the
# rest of the system (`ubus_prefix /ubus`), so the SPA can drive
# `tollgate --json` through the rpcd plugin.
#
# Scheme: the pair's HTTP port is the URL people type and its TLS port is the
# board's own listener, because one uhttpd instance cannot serve HTTP and HTTPS
# on the SAME port. Once that listener carries an identity that COVERS this
# router, the HTTP port REDIRECTS to it (uhttpd.admin.redirect_https=1), so the
# board's password fields are never typed on a cleartext origin. The identity is
# the one the module provisioned for this router
# (/etc/tollgate/ssl/server.{crt,key}, written by `tollgate ssl apply` from the
# module's 99-tollgate-setup); the OpenWrt image's own pair (/etc/uhttpd.crt,
# CN=OpenWrt) is only a fallback LISTENER identity — it keeps the TLS listener
# alive on a router that could not be provisioned, and never arms the redirect.
#
# NOTE: home is the brand webroot (/www/<brand>: /www/tollgate for the default
# TollGate build, a distribution's own webroot for a branded build), substituted
# into the setup script as __ADMIN_HOME__ at package build time, so uhttpd maps
# the instance's root -> /www/<brand>/index.html and /assets/... ->
# /www/<brand>/assets/.... Only one brand is ever installed, so only one of those
# directories exists.
#
# LuCI is NOT served here (its webroot is /www on uhttpd.main) — the admin
# instance never exposes /www. `home` MUST NOT be /www: uhttpd's default
# cgi_prefix (/cgi-bin) would then resolve /cgi-bin/luci to the real LuCI CGI on
# the admin port.
#
# The pair this instance owns belongs to it alone: the setup script removes it
# from any other section (and strips a stale copy of the other pair from itself),
# and drops leftover uhttpd sections + webroots from any OTHER brand skin
# (__FOREIGN_SKINS__) so a foreign skin can never shadow the board.
#
# The captive portal stays on uhttpd.portal (:2051); it is NOT touched here.

config uhttpd 'admin'
    list listen_http '0.0.0.0:8080'
    list listen_http '[::]:8080'
    list listen_https '0.0.0.0:443'
    list listen_https '[::]:443'
    option home '/www/tollgate'
    option cert '/etc/tollgate/ssl/server.crt'
    option key '/etc/tollgate/ssl/server.key'
    option redirect_https '1'
    option ubus_prefix '/ubus'
    option script_timeout '60'
    option network_timeout '30'
    option max_requests '3'
    option tcp_keepalive '1'
    option no_dirlists '1'
    option error_page '/index.html'
