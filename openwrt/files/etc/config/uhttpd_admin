# Reference snapshot of the uhttpd "admin" instance created by
# packaging/files/etc/uci-defaults/92-tollgate-admin-setup.
#
# The admin board is a second (Preact) SPA served at the ROOT of :8090. It
# binds the same ubus socket as the rest of the system (`ubus_prefix /ubus`),
# so the SPA can drive `tollgate --json` through the rpcd plugin.
#
# NOTE: home is the brand webroot (/www/tollgate for TollGate builds,
# /www/net4sats for net4sats), so uhttpd maps http://<gw>:8090/ ->
# /www/<brand>/index.html and /assets/... -> /www/<brand>/assets/.... Only one
# brand is ever installed, so only one of those directories exists. LuCI is NOT
# served here (its webroot is /www on uhttpd.main, :8080) — the admin instance
# never exposes /www.
#
# LuCI stays on uhttpd.main (:8080) and the captive portal on uhttpd.portal
# (:2051); those are NOT touched here.

config uhttpd 'admin'
    list listen_http '0.0.0.0:8090'
    list listen_http '[::]:8090'
    option home '/www/tollgate'
    option ubus_prefix '/ubus'
    option script_timeout '60'
    option network_timeout '30'
    option max_requests '3'
    option tcp_keepalive '1'
    option no_dirlists '1'
    option error_page '/index.html'
